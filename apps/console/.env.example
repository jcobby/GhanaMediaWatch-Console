SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Enables the role switcher at /roles. Demo only — never set in production.
DAWURO_DEMO_ROLES=on

# The Dawuro backend. Server-side only — never NEXT_PUBLIC_, because the token
# attached to these calls must not reach the browser.
#
# Unset means the console has no backend. It does NOT fall back to fixtures:
# a console showing seeded data during an outage shows an operator a queue that
# is not real, and they will act on it.
DAWURO_API_URL=https://698zp0x7-8000.uks1.devtunnels.ms
